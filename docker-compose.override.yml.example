# Пример override-файла ТОЛЬКО для локальной отладки.
# Скопируйте в docker-compose.override.yml (он в .gitignore и не попадёт в репозиторий).
# Compose автоматически объединит его с docker-compose.yml.
#
# ВАЖНО: при нескольких ботах задавайте РАЗНЫЕ хост-порты для каждого,
# иначе вернётся конфликт портов. Привязка к 127.0.0.1 закрывает доступ извне.

services:
  postgres:
    ports:
      - "127.0.0.1:5433:5432"   # у второго бота — 5434, и т.д.

  redis:
    ports:
      - "127.0.0.1:6380:6379"   # у второго бота — 6381, и т.д.
