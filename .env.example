# ============================================================================
#  ЕДИНЫЙ ФАЙЛ НАСТРОЕК БОТА
#  Скопируйте в .env  →  cp .env.example .env  →  заполните блок ниже  →  запуск.
# ============================================================================

# ─── ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ ───────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# ID канала (начинается с -100; узнать: переслать пост канала в @userinfobot)
CHANNEL_ID=

# Username канала без @
CHANNEL_USERNAME=

# Ваш Telegram ID (узнать: /start у @userinfobot). Несколько — через запятую.
ADMIN_IDS=

# ─── РЕКОМЕНДУЕТСЯ ИЗМЕНИТЬ ───────────────────────────────────────────────────
# Пароль базы данных (любая строка). Используется автоматически и ботом, и БД.
POSTGRES_PASSWORD=change_me_please

# ─── ОПЦИОНАЛЬНО (рабочие значения по умолчанию, можно не трогать) ────────────
# Часовой пояс для расписания и меток времени
TIMEZONE=Europe/Moscow

# Уникальное имя проекта — ВАЖНО при запуске НЕСКОЛЬКИХ ботов на одном сервере:
# задайте своё значение для каждого бота (bot_alpha, bot_beta, ...).
COMPOSE_PROJECT_NAME=tg_bot

# Имя БД и пользователь (менять не обязательно)
POSTGRES_DB=tg_bot_db
POSTGRES_USER=tg_bot_user

# Путь к лог-файлу внутри контейнера
LOG_PATH=logs/bot.log

# ─── ДЛЯ ЗАПУСКА БЕЗ DOCKER (локально) ───────────────────────────────────────
# В Docker трогать НЕ нужно. Локально раскомментируйте и укажите localhost:
# POSTGRES_HOST=localhost
# REDIS_HOST=localhost
#
# Либо задайте строки подключения целиком (тогда части выше игнорируются):
# DATABASE_URL=postgresql+asyncpg://tg_bot_user:change_me_please@localhost:5432/tg_bot_db
# REDIS_URL=redis://localhost:6379/0
