# ============================================================================
#  Запуск НЕСКОЛЬКИХ ботов на одном сервере
#  Для каждого бота: своя копия папки + свой .env с уникальными значениями ниже.
#  COMPOSE_PROJECT_NAME изолирует контейнеры, тома и сеть этого бота от других.
# ============================================================================
COMPOSE_PROJECT_NAME=tg_bot

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=your_channel_username
ADMIN_IDS=123456789,987654321

# Timezone
TIMEZONE=Europe/Moscow

# ----------------------------------------------------------------------------
# Database Configuration
# В Docker имя хоста = "postgres" (имя сервиса), порт всегда 5432 внутри сети.
# Креды ниже используются И контейнером postgres, И строкой подключения.
# Для нескольких ботов с ПОЛНОЙ изоляцией можно оставить одинаковыми —
# у каждого бота свой контейнер postgres со своим томом.
# ----------------------------------------------------------------------------
POSTGRES_DB=tg_bot_db
POSTGRES_USER=tg_bot_user
POSTGRES_PASSWORD=change_me_please

# Строка подключения для бота (Docker): host = postgres, port = 5432.
# Для локального запуска без Docker: postgresql+asyncpg://user:password@localhost:5432/tg_bot_db
DATABASE_URL=postgresql+asyncpg://tg_bot_user:change_me_please@postgres:5432/tg_bot_db

# ----------------------------------------------------------------------------
# Redis Configuration
# В Docker host = "redis". Для локального запуска: redis://localhost:6379/0
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# Порты Postgres/Redis на хост НЕ публикуются (полная изоляция ботов).
# Если для отладки нужен прямой доступ — скопируйте docker-compose.override.yml.example
# в docker-compose.override.yml и задайте уникальные порты для этого бота.
# ----------------------------------------------------------------------------

# Logging
LOG_PATH=logs/bot.log
