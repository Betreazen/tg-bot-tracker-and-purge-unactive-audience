# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=your_channel_username
ADMIN_IDS=123456789,987654321

# Timezone
TIMEZONE=Europe/Moscow

# Database Configuration
# For Docker deployment, use: postgresql+asyncpg://tg_bot_user:tg_bot_password@postgres:5432/tg_bot_db
# For local deployment, use: postgresql+asyncpg://user:password@localhost:5432/tg_bot_db
DATABASE_URL=postgresql+asyncpg://tg_bot_user:tg_bot_password@postgres:5432/tg_bot_db

# Redis Configuration
# For Docker deployment, use: redis://redis:6379/0
# For local deployment, use: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Logging
LOG_PATH=logs/bot.log
